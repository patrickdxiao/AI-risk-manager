{
  "name": "development-risk-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc",
    "start": "node dist/api/main.js",
    "gateway": "pnpm build && node dist/api/main.js",
    "benchmark": "pnpm build && node scripts/benchmark.mjs",
    "dashboard": "node dist/api/main.js --sign-in-link"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@types/node": "24.3.0",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.34.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "fastify": "5.12.1",
    "zod": "4.5.4"
  }
}

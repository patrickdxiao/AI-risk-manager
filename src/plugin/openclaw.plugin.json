{
  "id": "development-risk",
  "name": "Development Risk",
  "description": "Four read-only tools bound to a local risk investigation attempt",
  "version": "0.0.0",
  "activation": { "onStartup": true },
  "contracts": {
    "tools": ["risk_get_context", "risk_get_evidence", "risk_list_evidence", "risk_inspect_git"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["credentialsDirectory", "investigationAgentId"],
    "properties": {
      "credentialsDirectory": { "type": "string", "minLength": 1 },
      "investigationAgentId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
      "apiBaseUrl": { "type": "string", "default": "http://127.0.0.1:4317" },
      "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 30000, "default": 5000 },
      "maxResponseBytes": {
        "type": "integer",
        "minimum": 1024,
        "maximum": 2097152,
        "default": 524288
      }
    }
  }
}
